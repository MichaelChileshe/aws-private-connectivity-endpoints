{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyObjectAccessUnlessFromClaimsVpce",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::themba-claims-private-ACCOUNT_ID",
        "arn:aws:s3:::themba-claims-private-ACCOUNT_ID/*"
      ],
      "Condition": {
        "StringNotEquals": { "aws:SourceVpce": "S3_GATEWAY_ENDPOINT_ID" }
      }
    }
  ]
}
