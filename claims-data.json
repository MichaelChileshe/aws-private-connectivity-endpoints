{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ClaimsBucketReadWrite",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::themba-claims-private-ACCOUNT_ID",
        "arn:aws:s3:::themba-claims-private-ACCOUNT_ID/*"
      ]
    },
    {
      "Sid": "ClaimsTableReadWrite",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:GetItem", "dynamodb:Query"],
      "Resource": "arn:aws:dynamodb:us-east-1:ACCOUNT_ID:table/themba-claims"
    }
  ]
}
